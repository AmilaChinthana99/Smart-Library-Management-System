{
  "name": "smart-library-management-system",
  "version": "1.0.0",
  "description": "Full-Stack Smart Library Management System with React, Node.js, Express, and MongoDB",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "test:api": "npm run test:api --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": ["library", "management", "react", "express", "mongodb", "jwt"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
